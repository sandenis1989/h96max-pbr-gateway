[Unit]
Description=Policy-Based Routing (fwmark 0x1 -> table 100) for Hysteria 2 TPROXY
After=network-pre.target
Before=network.target hysteria.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/pbr-rules.sh
ExecStop=-/sbin/ip rule del fwmark 0x1 table 100
ExecStop=-/sbin/ip route del local default dev lo table 100

[Install]
WantedBy=multi-user.target
