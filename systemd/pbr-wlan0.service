[Unit]
Description=Static address for wlan0 AP interface
After=network-pre.target
Before=hostapd.service dnsmasq.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/ip link set wlan0 up
ExecStart=/sbin/ip addr replace 192.168.12.1/24 dev wlan0

[Install]
WantedBy=multi-user.target
