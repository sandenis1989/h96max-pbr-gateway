[Unit]
Description=Hysteria 2 Client Service
After=network.target network-online.target pbr-rules.service
Wants=network-online.target
Requires=pbr-rules.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/hysteria client -c /etc/hysteria/config.yaml --disable-update-check
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
