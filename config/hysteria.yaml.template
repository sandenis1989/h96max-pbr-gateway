# Hysteria 2 client config.
# NOTE: schema is for the pinned app/v2.14.0 build (separate tcpTProxy/udpTProxy/tcpRedirect modes).
server: ${HYSTERIA_SERVER}
auth: ${HYSTERIA_AUTH_SECRET}

tls:
  sni: ${HYSTERIA_SNI}
  insecure: ${HYSTERIA_TLS_INSECURE}

tcpTProxy:
  listen: :${HYSTERIA_TPROXY_PORT}

udpTProxy:
  listen: :${HYSTERIA_TPROXY_PORT}
  timeout: 300s

tcpRedirect:
  listen: :${HYSTERIA_REDIRECT_PORT}

fastOpen: true

bandwidth:
  up: 100 mbps
  down: 300 mbps
