# Target host SSH details
TARGET_HOST=root@192.168.0.102

# Wi-Fi Access Point settings
WLAN_IFACE=wlan0
WLAN_IP=192.168.12.1
WLAN_SSID=PBR-Gateway-WiFi
WLAN_PASSPHRASE=ChangeMeSecurePassword123!
WLAN_CHANNEL=6

# WAN Interface
WAN_IFACE=eth0

# Hysteria 2 Client Settings (VPS Oslo)
HYSTERIA_SERVER=1.2.3.4:443
HYSTERIA_AUTH_SECRET=YourHysteriaPasswordHere
HYSTERIA_SNI=your-vps-domain.example.com
HYSTERIA_TPROXY_PORT=7893
HYSTERIA_REDIRECT_PORT=7892

# Tailscale Settings (optional)
TAILSCALE_AUTHKEY=tskey-auth-xxxxxx-xxxxxx
